# ============================================================================
# Configuración del backend - Sistema de Justificantes UTXJ
# Copiar este archivo como backend/.env y ajustar los valores locales.
# Nunca subir backend/.env al repositorio.
# ============================================================================

NODE_ENV=development
PORT=3000

# Base de datos MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_justificantes_utxj
DB_CONNECTION_LIMIT=10

# Seguridad de sesión
JWT_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria-de-64-caracteres
JWT_EXPIRES_IN=8h
COOKIE_NAME=utxj_sesion
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# Archivos privados (comprobantes, firmas y sellos)
UPLOAD_ROOT=uploads
MAX_FILE_SIZE_MB=5

# Operación
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
